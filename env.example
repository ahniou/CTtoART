# OpenCTI connection
# Use the platform URL (no trailing slash) and a token issued to a service account.
OPENCTI_URL=https://opencti.your-domain.local
OPENCTI_TOKEN=00000000-0000-0000-0000-000000000000

# Local Atomic Red Team checkout. Either point at the cloned repo root or directly
# at the index CSV: <repo>/atomics/Indexes/Indexes-CSV/index.csv
ATOMICS_PATH=/opt/atomic-red-team

# Set to "true" to allow on-the-fly download of the ART index from GitHub when no
# local copy is available. Disabled by default for air-gapped deployments.
ART_ALLOW_REMOTE=false